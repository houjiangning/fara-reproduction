set puf_lock_ok  0
set puf_lock_bad 0
foreach p $puf_lock_pairs {
  set nm  [lindex $p 0]
  set loc [lindex $p 1]
  set bel [lindex $p 2]
  if {[llength $p] != 3} {
    incr puf_lock_bad
    continue
  }
  set c [get_cells -quiet -hier -regexp $nm]
  if {[llength $c] != 1} {
    incr puf_lock_bad
    continue
  }
  if {[catch { set_property LOC $loc $c } e]} {
    incr puf_lock_bad
    continue
  }
  if {$bel ne ""} { catch { set_property BEL $bel $c } }
  incr puf_lock_ok
}
if {$puf_lock_bad > 0} {
  puts "== puf_lock: WARNING $puf_lock_bad pin records FAILED, $puf_lock_ok pinned"
} else {
  puts "== puf_lock: $puf_lock_ok butterfly LUTs pinned by LOC and BEL"
}

